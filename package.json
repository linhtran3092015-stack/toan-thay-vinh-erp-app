{
  "name": "toan-thay-vinh-erp-app",
  "version": "0.35.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:rtl": "vitest run tests/components",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "test:db:fresh": "supabase start && supabase db reset --local && supabase test db",
    "staging:preflight": "node scripts/verify-staging-target.mjs",
    "supabase:status": "supabase status",
    "supabase:link": "supabase link",
    "supabase:db:pull": "supabase db pull --linked",
    "supabase:db:push": "supabase db push --linked",
    "supabase:migration:new": "supabase migration new",
    "supabase:types": "supabase gen types --linked --lang typescript --schema public > src/types/database.generated.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hookform/resolvers": "^5.4.0",
    "@serwist/next": "^9.5.13",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^1.30.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "read-excel-file": "9.2.0",
    "serwist": "^9.5.13",
    "write-excel-file": "4.1.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.10",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
