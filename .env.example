NEXT_PUBLIC_SUPABASE_URL=
# Preferred public browser/server key from Supabase project settings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Temporary compatibility fallback for projects that still expose an anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated, exact-match Google email allowlist. Server only.
AUTH_ALLOWED_EMAILS=
# Server-only key for privileged webhook processing. Never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# SePay HMAC-SHA256 secret. Receiving-account mapping is server-only.
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
# New-enrollment receiving account. BANK_CODE must match a SePay/VietQR bank alias.
SEPAY_NEW_ENROLLMENT_ACCOUNT_NUMBER=
SEPAY_NEW_ENROLLMENT_BANK_CODE=
SEPAY_NEW_ENROLLMENT_ACCOUNT_HOLDER=
SEPAY_NEW_ENROLLMENT_TRANSFER_PREFIX=
# Renewal receiving account. It must be distinct from the new-enrollment account.
SEPAY_RENEWAL_ACCOUNT_NUMBER=
SEPAY_RENEWAL_BANK_CODE=
SEPAY_RENEWAL_ACCOUNT_HOLDER=
SEPAY_RENEWAL_TRANSFER_PREFIX=
# Optional, ASCII without Vietnamese diacritics as required by SePay's QR image API.
