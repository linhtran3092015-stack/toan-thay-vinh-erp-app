NEXT_PUBLIC_SUPABASE_URL=
# Preferred public browser/server key from Supabase project settings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Temporary compatibility fallback for projects that still expose an anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated, exact-match Google email allowlist. Server only.
AUTH_ALLOWED_EMAILS=
# Server-only key for privileged webhook processing. Never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# SePay HMAC-SHA256 secret and the bank account receiving the centre's payments.
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
# Server-only VietQR display settings. BANK_CODE must match a SePay/VietQR bank alias.
SEPAY_BANK_CODE=
# Optional, ASCII without Vietnamese diacritics as required by SePay's QR image API.
SEPAY_ACCOUNT_HOLDER=
# Optional bank/VA memo prefix such as SEVQR or TKP001.
SEPAY_TRANSFER_PREFIX=
