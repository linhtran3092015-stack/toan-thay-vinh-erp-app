# Staging Environment Template
# Fill in real staging secrets in secure host environment variables (Vercel / CI).
# Never commit real secret values or service-role keys to Git.

# Supabase Staging Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://kdscaoudnxekytfvqotf.supabase.co
# Preferred public browser/server publishable key from Supabase project settings.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Temporary compatibility fallback for projects that still expose an anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-Only Security Configuration
# Comma-separated, exact-match staging email allowlist.
AUTH_ALLOWED_EMAILS=
# Server-only service role key for webhooks and administrative actions. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# SePay Staging Webhook and VietQR Configuration
SEPAY_WEBHOOK_SECRET=
# New-enrollment account. These values are server-only and must remain distinct
# from the renewal receiving account.
SEPAY_NEW_ENROLLMENT_ACCOUNT_NUMBER=
SEPAY_NEW_ENROLLMENT_BANK_CODE=
SEPAY_NEW_ENROLLMENT_ACCOUNT_HOLDER=
SEPAY_NEW_ENROLLMENT_TRANSFER_PREFIX=
# Renewal account.
SEPAY_RENEWAL_ACCOUNT_NUMBER=
SEPAY_RENEWAL_BANK_CODE=
SEPAY_RENEWAL_ACCOUNT_HOLDER=
SEPAY_RENEWAL_TRANSFER_PREFIX=

# Staging Playwright E2E Configuration
E2E_ENVIRONMENT=staging
E2E_BASE_URL=
E2E_SUPABASE_URL=https://kdscaoudnxekytfvqotf.supabase.co
E2E_SUPABASE_PROJECT_REF=kdscaoudnxekytfvqotf
E2E_ALLOWED_SUPABASE_PROJECT_REF=kdscaoudnxekytfvqotf
E2E_AUTH_STATE_PATH=playwright/.auth/operational.json
E2E_ALLOW_DESTRUCTIVE_TESTS=false
